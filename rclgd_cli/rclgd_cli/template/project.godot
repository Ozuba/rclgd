; Godot project generated by `ros2 rclgd create`.
; It's best edited using the editor UI (`ros2 rclgd editor $name`).

config_version=5

[application]

config/name="$name"
config/description="$description"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("$godot_version", "$renderer_feature")

[autoload]

ROS="*res://addons/rclgd/ros_init.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/rclgd/plugin.cfg")
$rendering_section